# Hugo Admin 配置示例
# 复制为 .env 按需修改；已存在的环境变量优先于 .env。
# 字段语义见 internal/config/config.go 与 cmd/hugo-admin/main.go。

# ---------- 本地启动（./run.sh / go run，Go 应用读取） ----------

# 监听端口（默认 5050）
PORT=5050

# Hugo 站点根目录（git 仓库，content/ 的父目录；默认为仓库根，本地使用务必修改）
#HUGO_ROOT=/path/to/your/hugo-site

# Hugo 内容目录（默认 <HUGO_ROOT>/content，须可写）
#CONTENT_DIR=/path/to/your/hugo-site/content

# 会话密钥（生产环境必须修改）
SECRET_KEY=dev-secret-key-change-in-production

# 管理员账户（首次启动写入 data/auth.json；不设置则以 admin/admin 引导，务必尽快改密）
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-strong-password

# 服务端托管的前端产物目录（默认 admin-ui）
# 注意：vite 构建输出固定为 admin-ui/（frontend/vite.config.ts 的 outDir），
# 改此项需自行把产物放到对应目录
#ADMIN_UI_DIR=admin-ui

# 凭据文件路径（默认 data/auth.json）
#AUTH_STORE=data/auth.json

# API Token（机器客户端 Bearer 鉴权；留空关闭 token 登录）
#API_TOKEN=

# AI 助手（不设置 AI_API_KEY 则禁用 AI 功能）
#AI_API_KEY=
#AI_BASE_URL=https://api.example.com/v1
#AI_MODEL=

# Hugo 预览服务器对外地址
#HUGO_SERVER_BASE_URL=http://localhost:1313

# ---------- Docker Compose（docker-compose.yml 插值读取） ----------

# Hugo 博客目录（挂载其 content/public/static 等子目录）
HUGO_BLOG_DIR=../hugo-blog

# Hugo 主题目录（挂载为容器内主题）
HUGO_THEME_DIR=../Fried-Rice
